# tfpp-ds41: the settings every stage gets alike (KEY=value lines; start_stage.sh / run_shortened.sh read them, never
# run them). HELLO compares a digest of every TF_DS_* / TF_EXL3_* / TENSORFOLD_* / TFPP_DS41_* / TF_TP_* / TF_SEED
# value and of the Triton / cuBLAS / TF32 numerics knobs -- each node's own excluded (paths, the Engram I/O mechanics,
# the observation switches: env.PER_NODE) -- and refuses a mismatch; the scripts clear all of these before reading
# this file. The values follow the fork's public 2x DGX Spark TP2 recipe (tools/dsv41/REPORT.md of the fork, section 7:
# TF_DS_REPLAY=1 TF_DS_PREFILL_CHUNK=2048, --parallel 4 --mtp-drafts 5 --temperature 0) with the pipeline's own
# (spec 13.1).

# --- enforced (env.check_env refuses anything else) ----------------------------------------------------------------
TORCH_ALLOW_TF32_CUBLAS_OVERRIDE=0
TF_TP_WORLD=1
TF_DS_MEM_FLOOR_GIB=0
TF_DS_SPILL_GIB=0
TF_DS_KEEP=0
TF_DS_ENGRAM_SPLIT=1
TF_DS_KERNELS=1
TF_DS_KV=native
TENSORFOLD_NO_UPDATE_CHECK=1
TENSORFOLD_NO_LIVE=1
HF_HUB_OFFLINE=1
# deliberately absent: TF_DS_RANK_CACHE, TF_DS_RDMA*, TF_RDMA_*, NCCL_*, TF_COMM_BACKEND, TF_NCCL_LIB, TF_TP_MASTER,
# TF_TP_PORT (check_env refuses them)

# --- the served numerics (spec 13.2) --------------------------------------------------------------------------------
TF_DS_PREFILL_CHUNK=2048
TF_DS_REPLAY=1
# decision item (spec 13.2): the fork's default is 0; 1 keeps a chunk of 2-16 rows past the
# replay floor off the ring's stale keys (F/model.py:30-41), which the chain's warm-up writes differently from the
# reference's. Match it to the fork's published recipe before the full-model run.
TF_DS_REPLAY_FLOOR=1
TF_DS_DECODE_ROWS=16
TF_DS_GRAPHS=1
TF_DS_BUCKET_MIN=1024
TF_DS_L2_PREFETCH=1
TF_DS_ONE_COPY=1
TF_DS_ROUND_SHARED_OUT=1
TF_DS_WARM=1
TF_DS_DEPTH_POLICY=conf
TF_DS_ADAPTIVE=0
TF_DS_MARKOV=1
# F1 fallback (spec 3.6): set to carry on EVERY stage only if kernel_check --hc (T-K') fails
TFPP_DS41_CUT_POST=post
# 1: the build captures the round graphs of every context bucket, not only those up to 8192 (the fork's warm-up), so
# READY's memory check covers what a long conversation would otherwise capture while serving (a stage tight on memory
# then fails at start, not mid-request). Costs start-up time; every stage alike (digested). Not yet run on hardware.
# TFPP_DS41_WARM_ALL_BUCKETS=1

# --- the leader's serve flags (not compared: the followers take them from GO / AGREE) ------------------------------
CONTEXT=262144
PARALLEL=4
MTP_DRAFTS=5
MAX_TOKENS=16384
THINKING=1
TEMPERATURE=0
SERVED_NAME=DeepSeek-V4.1-Flash
# 0.0.0.0 serves every interface of the leader's node: give the leader TF_API_KEY_FILE in its node.env (a chmod 600 file;
# the server then wants the key on every route but /health), or serve 127.0.0.1 only
HTTP_HOST=0.0.0.0
HTTP_PORT=18891
