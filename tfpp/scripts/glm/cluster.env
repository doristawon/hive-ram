# tfpp-glm: the settings every stage gets alike (KEY=value lines; start_stage.sh reads them, never runs them).
# The values follow MIA's published 2x DGX Spark recipe (v1.11-pre config.sh: PARALLEL=4 CONTEXT=262144 KV=fp8
# KV_POOL_GIB=6.2 DENSE=q4 DRAFTER=dflash2 DRAFT_POLICY=fnc7:0.3 COPY=1 COPY_CODE=1 COPY_MAX=15 KDA_CHUNKED=0
# MULTI_PREFILL=1 SHARED_PREFIX=1 TF_GLM_EXL3_LOADS=nc TF_GLM_L2PF=1 TF_GLM_MTP=auto TF_GLM_MULTI_LONE=0 THINKING=1
# VISION=1 MAX_TOKENS=16384) as its scripts/config.sh exports them, with the pipeline's own: no row split, no
# layer-sliced fill, no communicator. HELLO compares a digest of every TF_GLM_* / TENSORFOLD_* / TFPP_* value and of
# the Triton / cuBLAS / TF32 numerics knobs (but each node's own: TF_GLM_CACHE_GIB, TFPP_WARM_MS, TFPP_TRACE,
# TENSORFOLD_MEMORY_RESERVE_GIB, TFPP_GLM_*, TRITON_*_DIR / _PATH / _HOME) and refuses a mismatch; the scripts
# clear all of these before reading this file.
# Before the first full-model run: check the v1.11-pre implicit defaults (e.g. FILL_ROWS) against MIA's published
# scripts/config.sh.

# --- numerics (spec 12.2) ------------------------------------------------------------------------------------------
TF_GLM_DENSE=q4
TF_GLM_KV=fp8
TF_GLM_KDA_CHUNKED=0
TF_GLM_LATENT=1
TF_GLM_KVB=bf16
TF_GLM_PREFILL_ROWS=2048
TF_GLM_PROMPT_GRID=0
TF_GLM_MAX_ROWS=16
TF_GLM_EXL3_LOADS=nc
TF_GLM_EXL3_DEC_ORDER=0
TF_GLM_L2PF=1

# --- drafting (the leader drafts; the window widths are every stage's CUDA graphs) ---------------------------------
TF_GLM_MTP=auto
TF_GLM_DFLASH_POLICY=fnc7:0.3
TF_GLM_COPY_DRAFTS=1
TF_GLM_COPY_MAX=15
TF_GLM_WIDE_GRAPHS=16
TF_GLM_COPY_REPLY_MATCH=16
TF_GLM_DRAFT_RING=1
TF_GLM_DRAFT_QUANT=minmax
TF_GLM_DRAFT_PRELAUNCH=1
TF_GLM_ASSISTANT_ENDS=1

# --- kept prompts and streams --------------------------------------------------------------------------------------
TF_GLM_SHARED_PREFIX=1
TF_GLM_CACHE_ENTRIES=32
TF_GLM_CACHE_SHARE_PCT=0
TF_GLM_KEPT_BYTES_GIB=0
TF_GLM_KEEP_PER_CHAT=0
TF_GLM_MULTI_PREFILL=1
TF_GLM_MULTI_LONE=0
TF_GLM_MULTI_WINDOW=32
TF_GLM_MULTI_VERIFY=batched
TF_GLM_MULTI_SAMPLER=streams
TF_GLM_MULTI_DEPTH=policy
TF_GLM_MULTI_ASYNC=0
TF_GLM_MULTI_PROFILE=0
TF_GLM_FILL_ROWS=2048
TF_GLM_FILL_DRAFTS=1
# MIA's recipe: 200; layer-sliced fill runs prompt forwards on the leader alone (G/multi.py:573, 689): off (v2.x)
TF_GLM_FILL_BUDGET_MS=0
TENSORFOLD_NUCLEUS_UNION=1

# --- the HTTP side (only the leader reads them) --------------------------------------------------------------------
TF_GLM_CLEAR_THINKING=0
TF_GLM_EFFORT_TAIL=0
TF_GLM_STREAM_SMOOTH=1
TF_GLM_STREAM_SMOOTH_MS=400

# --- tensor-parallel only: off in a pipeline (world=1 raises: G/hcsplit.py:147-149) --------------------------------
TF_GLM_HC_SPLIT=0
TF_GLM_PREFILL_OVERLAP=0
TF_GLM_DISPLAY_KV_MIB=0
# deliberately absent: TF_GLM_COMM, TF_ROCE_*, NCCL_*, TF_GLM_DRAFT_DUMP (env.check_env refuses them)

TENSORFOLD_NO_UPDATE_CHECK=1
HF_HUB_OFFLINE=1

# --- the leader's serve flags (not compared: the followers take them from GO / AGREE) ------------------------------
# HTTP_HOST=0.0.0.0 serves the OpenAI-style API on every interface WITHOUT authentication: anyone who can reach the
# port can use the model. Keep it behind a firewall or a trusted link, or set HTTP_HOST=127.0.0.1 (this node only).
CONTEXT=262144
PARALLEL=1
MAX_TOKENS=16384
THINKING=1
VISION=1
VISION_URLS=0
SERVED_NAME=GLM-5.3-Flash-EXL3
HTTP_HOST=0.0.0.0
HTTP_PORT=8888
